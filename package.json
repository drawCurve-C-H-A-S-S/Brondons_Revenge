{
  "name": "brondons-revenge",
  "version": "1.0.0",
  "description": "Brondon's Revenge - Space Game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,js,css,html}\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"*.{js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,css,html}\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"*.{js,json}\"",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "audio:fallbacks": "node scripts/createAudioFallbacks.mjs",
    "textures:earth": "node scripts/createEarthTextures.mjs",
    "textures:bark": "node scripts/createBarkTextures.mjs",
    "animations:import": "node scripts/importQuaterniusAnimations.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "cannon-es": "^0.20.0",
    "gifuct-js": "^2.1.2",
    "pathfinding": "^0.4.18",
    "three": "^0.170.0",
    "three-bvh-csg": "^0.0.17",
    "three-mesh-bvh": "0.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/pathfinding": "^0.1.0",
    "@types/three": "^0.170.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.0.0"
  }
}
